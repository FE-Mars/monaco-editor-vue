{
  "name": "monaco-editor-vue",
  "version": "2.0.0",
  "description": "Monaco Editor for Vue 3.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsdown",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FE-Mars/monaco-editor-vue.git"
  },
  "bugs": {
    "url": "https://github.com/FE-Mars/monaco-editor-vue/issues"
  },
  "homepage": "https://github.com/FE-Mars/monaco-editor-vue",
  "peerDependencies": {
    "monaco-editor": "^0.56.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^18.0.1",
    "monaco-editor": "^0.56.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2",
    "unplugin-vue": "^7.0.1",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.7"
  },
  "keywords": [
    "Vue",
    "Vue3",
    "monaco",
    "monaco-editor",
    "vite",
    "vue-monaco-editor",
    "monaco-editor-vue"
  ],
  "author": "jwong",
  "license": "MIT",
  "sideEffects": false
}
